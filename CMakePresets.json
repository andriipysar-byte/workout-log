{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "dev",
      "displayName": "Debug (./build/dev)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan (./build/asan)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WL_SANITIZE": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (./build/release)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "headless",
      "displayName": "Debug without the Qt app (./build/headless)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WL_BUILD_APP": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen", "ASAN_OPTIONS": "detect_container_overflow=0:halt_on_error=1" } },
    { "name": "dev", "configurePreset": "dev", "inherits": "base" },
    { "name": "asan", "configurePreset": "asan", "inherits": "base" },
    { "name": "release", "configurePreset": "release", "inherits": "base" },
    { "name": "headless", "configurePreset": "headless", "inherits": "base" }
  ]
}
