<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox is off deliberately. ADR-001 makes an arbitrary folder of
	     JSON files the source of truth, and $WORKOUTLOG_DATA may point anywhere;
	     a sandboxed app can only reach paths the user picked in this launch,
	     which would make the canonical folder unreadable on every restart.
	     This is a personal tool, not an App Store submission. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
