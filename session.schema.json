{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workoutlog2/schema/session.schema.json",
  "title": "Training session",
  "type": "object",
  "required": ["date", "cycle_day", "blocks"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "cycle_day": { "type": "string", "pattern": "^[A-F][12]$" },
    "start_time": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}$" },
    "kind": { "enum": ["training", "deload", "retest"], "default": "training" },
    "bodyweight_kg": { "type": "number" },
    "notes": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}$" },

    "block": {
      "oneOf": [
        { "$ref": "#/$defs/cardio" },
        { "$ref": "#/$defs/strength" },
        { "$ref": "#/$defs/metcon" },
        { "$ref": "#/$defs/cooldown" }
      ]
    },

    "cardio": {
      "type": "object",
      "required": ["type", "machine"],
      "properties": {
        "type": { "const": "cardio" },
        "machine": { "type": "string" },
        "duration_min": { "type": "number" },
        "distance_m": { "type": "number" },
        "end_time": { "$ref": "#/$defs/time" }
      }
    },

    "strength": {
      "type": "object",
      "required": ["type", "exercise", "sets"],
      "properties": {
        "type": { "const": "strength" },
        "exercise": { "type": "string" },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/set" } },
        "start_time": { "$ref": "#/$defs/time" },
        "end_time": { "$ref": "#/$defs/time" },
        "notes": { "type": "string" }
      }
    },

    "set": {
      "type": "object",
      "description": "Effort unit is polymorphic: reps, duration_sec, or cluster.",
      "properties": {
        "weight_kg": { "type": "number" },
        "reps": { "type": "integer" },
        "duration_sec": { "type": "number" },
        "cluster": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "e.g. [5,5,4,3,3]"
        },
        "total_reps": { "type": "integer" },
        "rir": { "type": "number" },
        "rep_band": { "enum": ["heavy", "base", "volume"] },
        "bar_speed": { "enum": ["fast", "ok", "slow", "grind"] },
        "is_backoff": { "type": "boolean", "default": false },
        "planned_reps": {
          "type": "integer",
          "description": "Where the paper log shows a struck-through value."
        },
        "notes": { "type": "string" }
      }
    },

    "metcon": {
      "type": "object",
      "required": ["type", "exercises"],
      "properties": {
        "type": { "const": "metcon" },
        "format": {
          "enum": ["for_time", "amrap", "emom", "intervals", "ladder", "chipper"],
          "default": "for_time"
        },
        "scheme": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Reps per round, e.g. [21,15,9]"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "weight_kg": { "type": "number" },
              "reps_override": {
                "type": "array",
                "items": { "type": "integer" },
                "description": "When this movement does not follow the scheme (e.g. skipping 65/45/30)."
              }
            }
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": { "type": "integer" },
              "reps": { "type": "integer" },
              "split_cumulative_sec": {
                "type": "number",
                "description": "As written on paper. Round splits are derived."
              },
              "heart_rate": { "type": "integer" }
            }
          }
        },
        "start_time": { "$ref": "#/$defs/time" },
        "end_time": { "$ref": "#/$defs/time" },
        "notes": { "type": "string" }
      }
    },

    "cooldown": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "cooldown" },
        "end_time": { "$ref": "#/$defs/time" },
        "notes": { "type": "string" }
      }
    }
  }
}
